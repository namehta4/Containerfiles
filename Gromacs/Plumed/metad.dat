WHOLEMOLECULES ENTITY0=1-66
phi1: TORSION ATOMS=60,45,44,34
psi1: TORSION ATOMS=45,44,34,30
phi2: TORSION ATOMS=43,24,23,13
psi2: TORSION ATOMS=24,23,13,9
metad1: METAD ARG=phi1,psi1 SIGMA=0.35,0.35 PACE=500 CALC_RCT HEIGHT=1 RCT_USTRIDE=500 GRID_MIN=-pi,-pi GRID_MAX=pi,pi GRID_SPACING=0.1,0.1 GRID_WFILE=GRID GRID_WSTRIDE=5000 BIASFACTOR=15 TEMP=298
metad2: METAD ARG=phi2,psi2 SIGMA=0.35,0.35 PACE=500 CALC_RCT HEIGHT=1 RCT_USTRIDE=500 GRID_MIN=-pi,-pi GRID_MAX=pi,pi GRID_SPACING=0.1,0.1 GRID_WFILE=GRID GRID_WSTRIDE=5000 BIASFACTOR=15 TEMP=298
PRINT ARG=phi1,psi1,metad1.rbias,phi2,psi2,metad2.rbias STRIDE=250 FILE=COLVAR
